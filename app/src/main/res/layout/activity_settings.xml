<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#14141C"
    android:padding="14dp">

    <LinearLayout android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <TextView android:text="厂商" android:textColor="#FFB86C" android:textSize="13sp"
            android:layout_width="wrap_content" android:layout_height="wrap_content" />
        <Spinner android:id="@+id/spProvider" android:layout_width="match_parent"
            android:layout_height="wrap_content" android:layout_marginBottom="10dp" />

        <TextView android:text="API Key（只存在你手机本地）" android:textColor="#FFB86C" android:textSize="13sp"
            android:layout_width="wrap_content" android:layout_height="wrap_content" />
        <EditText android:id="@+id/etKey" android:layout_width="match_parent"
            android:layout_height="wrap_content" android:hint="粘贴你的 API Key"
            android:inputType="textPassword" android:textColor="#FFFFFF"
            android:textColorHint="#66707F" android:layout_marginBottom="10dp" />

        <TextView android:text="接口地址 Base URL" android:textColor="#FFB86C" android:textSize="13sp"
            android:layout_width="wrap_content" android:layout_height="wrap_content" />
        <EditText android:id="@+id/etBase" android:layout_width="match_parent"
            android:layout_height="wrap_content" android:hint="https://..."
            android:inputType="textUri" android:textColor="#FFFFFF"
            android:textColorHint="#66707F" android:layout_marginBottom="10dp" />

        <TextView android:text="绘图模型 ID" android:textColor="#FFB86C" android:textSize="13sp"
            android:layout_width="wrap_content" android:layout_height="wrap_content" />
        <EditText android:id="@+id/etImgModel" android:layout_width="match_parent"
            android:layout_height="wrap_content" android:textColor="#FFFFFF"
            android:textColorHint="#66707F" android:layout_marginBottom="10dp" />

        <TextView android:text="视频模型 ID" android:textColor="#FFB86C" android:textSize="13sp"
            android:layout_width="wrap_content" android:layout_height="wrap_content" />
        <EditText android:id="@+id/etVidModel" android:layout_width="match_parent"
            android:layout_height="wrap_content" android:textColor="#FFFFFF"
            android:textColorHint="#66707F" android:layout_marginBottom="10dp" />

        <TextView android:text="画风（所有镜头统一附加）" android:textColor="#FFB86C" android:textSize="13sp"
            android:layout_width="wrap_content" android:layout_height="wrap_content" />
        <EditText android:id="@+id/etStyle" android:layout_width="match_parent"
            android:layout_height="wrap_content" android:minLines="2"
            android:textColor="#FFFFFF" android:textColorHint="#66707F"
            android:layout_marginBottom="10dp" />

        <Button android:id="@+id/btnTest" android:layout_width="match_parent"
            android:layout_height="wrap_content" android:text="测试连通性"
            android:layout_marginBottom="8dp" />
        <TextView android:id="@+id/tvTest" android:layout_width="match_parent"
            android:layout_height="wrap_content" android:text="" android:textSize="12sp"
            android:textColor="#8890A0" android:layout_marginBottom="10dp" />

        <Button android:id="@+id/btnSave" android:layout_width="match_parent"
            android:layout_height="wrap_content" android:text="保存" />
    </LinearLayout>
</ScrollView>
